<?xml version="1.0" encoding="utf-8"?>
<Window
   x:Class="MarkdownViewr.Windows.MainWindow"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <Window.SystemBackdrop>
      <MicaBackdrop />
   </Window.SystemBackdrop>

   <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <MenuBar>
         <MenuBarItem Title="File">
            <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open..." Click="Open_Click">
               <MenuFlyoutItem.KeyboardAccelerators>
                  <KeyboardAccelerator Key="O" Modifiers="Control" />
               </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="ReloadMenuItem" Text="Reload" Click="Reload_Click" IsEnabled="False" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ExitMenuItem" Text="Exit" Click="Exit_Click" />
         </MenuBarItem>
         <MenuBarItem Title="View">
            <MenuFlyoutSubItem x:Name="DocumentThemesMenu" Text="Document theme" />
            <MenuFlyoutItem x:Name="EditDocumentThemeMenu" Text="Edit document theme..." Click="EditDocumentTheme_Click" />
            <MenuFlyoutItem x:Name="RestoreDocumentThemesMenu" Text="Restore built-in themes" Click="RestoreDocumentThemes_Click" />
            <MenuFlyoutSeparator />
            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="System theme" GroupName="Theme" Tag="System" Click="Theme_Click" />
            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light theme" GroupName="Theme" Tag="Light" Click="Theme_Click" />
            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark theme" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
            <MenuFlyoutSeparator />
            <ToggleMenuFlyoutItem x:Name="SplashToggle" Text="Show splash at startup" Click="Splash_Click" />
            <ToggleMenuFlyoutItem x:Name="UpdateCheckToggle" Text="Check for updates at startup" Click="UpdateCheck_Click" />
         </MenuBarItem>
         <MenuBarItem Title="Help">
            <MenuFlyoutItem x:Name="CheckForUpdatesMenuItem" Text="Check for updates" Click="CheckForUpdates_Click" />
            <MenuFlyoutItem x:Name="ActivityLogMenuItem" Text="Activity log" Click="ActivityLog_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="AboutMenuItem" Text="About MarkdownViewr" Click="About_Click" />
         </MenuBarItem>
      </MenuBar>

      <TextBlock x:Name="StatusText" Grid.Row="2" Margin="16,8" Text="Starting the document surface..." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="StatusText" AutomationProperties.Name="{Binding Text, ElementName=StatusText}" AutomationProperties.AccessibilityView="Content" AutomationProperties.LiveSetting="Polite" />
      <WebView2 x:Name="DocumentView" Grid.Row="1" Loaded="DocumentView_Loaded" AutomationProperties.Name="Markdown document" />
   </Grid>
</Window>
