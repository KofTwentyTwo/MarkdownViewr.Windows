<Project Sdk="Microsoft.NET.Sdk">

   <!-- Out-of-process UI tests: FlaUI drives the built app over UI Automation, so this
        project references only MarkdownViewr.Windows.Core (for the app's identity), never the WinUI
        project. Build the solution first (dotnet build MarkdownViewr.Windows.slnx -p:Platform=x64), or
        point K22_UITEST_EXE at the exe to test. -->
   <PropertyGroup>
      <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="FlaUI.UIA3" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit" />
      <PackageReference Include="xunit.runner.visualstudio" />
   </ItemGroup>

   <ItemGroup>
      <Using Include="Xunit" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\..\src\MarkdownViewr.Windows.Core\MarkdownViewr.Windows.Core.csproj" />
   </ItemGroup>

   <ItemGroup>
      <!-- The app's own namespaces are global usings: their sort position against other
           usings depends on the app's name, which the template replaces. -->
      <Using Include="MarkdownViewr.Windows.Core" />
   </ItemGroup>

   <ItemGroup>
      <!-- Exercise the actual native file adapter without loading WinUI or reserving the desktop. -->
      <Compile Include="..\..\src\MarkdownViewr.Windows\DocumentFiles.cs" Link="WindowsAdapters\DocumentFiles.cs" />
      <Compile Include="..\..\src\MarkdownViewr.Windows\DocumentWatcher.cs" Link="WindowsAdapters\DocumentWatcher.cs" />
   </ItemGroup>

</Project>
